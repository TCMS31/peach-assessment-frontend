# Base URL of the peach-take-home-back-end Rails API.
#
# Leave unset to use the platform default:
#   iOS simulator / web -> http://localhost:3000
#   Android emulator    -> http://10.0.2.2:3000
#
# Set it explicitly when running on a physical device, using your machine's
# LAN address. No trailing slash and no trailing whitespace.
PEACH_API_URL=http://localhost:3000
